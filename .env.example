# ---------------------------------------------------------------------------
# Jeck's — copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
TZ=UTC

# --- Database (docker compose service `postgres`) ---
POSTGRES_USER=jecks
POSTGRES_PASSWORD=jecks
POSTGRES_DB=jecks
POSTGRES_PORT=5432
DATABASE_URL=postgresql://jecks:jecks@localhost:5432/jecks?schema=public

# --- Redis / BullMQ ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO in dev, R2/S3 in prod) ---
STORAGE_DRIVER=s3
MINIO_ROOT_USER=jecks
MINIO_ROOT_PASSWORD=jecks-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=jecks-media
S3_ACCESS_KEY=jecks
S3_SECRET_KEY=jecks-secret
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/jecks-media
# Used when STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage

# --- Mail (Mailpit in dev) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="Jeck's <no-reply@jecks.dz>"

# --- Auth (PRD Section 10.3) ---
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
# Encrypts courier and payment credentials at rest. 32 bytes, base64.
CREDENTIALS_KEY=ZGV2LW9ubHktY2hhbmdlLW1lLTMyLWJ5dGVzLWtleSE=

# --- Ports ---
API_PORT=4000
ADMIN_PORT=5174
STOREFRONT_PORT=3000

# --- URLs ---
API_URL=http://localhost:4000
API_PUBLIC_URL=http://localhost:4000/api/v1
STOREFRONT_URL=http://localhost:3000
ADMIN_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:3000,http://localhost:5174

# --- Storefront (Next.js needs the NEXT_PUBLIC_ prefix for browser access) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MEDIA_URL=http://localhost:9000/jecks-media

# --- Admin (Vite) ---
VITE_API_URL=http://localhost:4000/api/v1
VITE_MEDIA_URL=http://localhost:9000/jecks-media

# --- Notification adapters (all optional, log-only by default) ---
SMS_DRIVER=log
SMS_SENDER=JECKS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_DRIVER=link
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Seed ---
SEED_OWNER_EMAIL=owner@jecks.dz
SEED_OWNER_PASSWORD=Jecks2026!
SEED_DEMO_DATA=true

# Note: if 5432/6379/9000/1025 are already used on your machine, override the *_PORT
# values above and keep DATABASE_URL / REDIS_URL / S3_ENDPOINT in sync.
