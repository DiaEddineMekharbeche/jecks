# syntax=docker/dockerfile:1
#
# Admin SPA: built to static files, served by Nginx.
#   docker build -f infra/docker/Dockerfile.admin -t jecks/admin .

FROM node:20-alpine AS build
RUN corepack enable
WORKDIR /app

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml .npmrc ./
COPY packages/config/package.json packages/config/
COPY packages/shared/package.json packages/shared/
COPY packages/ui/package.json packages/ui/
COPY apps/admin/package.json apps/admin/
RUN pnpm install --frozen-lockfile --filter @jecks/admin...

ARG VITE_API_URL
ARG VITE_MEDIA_URL
COPY packages/ packages/
COPY apps/admin/ apps/admin/
RUN pnpm --filter @jecks/shared build && pnpm --filter @jecks/admin build

FROM nginx:alpine AS runtime
COPY --from=build /app/apps/admin/dist /usr/share/nginx/html
COPY infra/nginx/admin-spa.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
