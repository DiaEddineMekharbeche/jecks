{
  "name": "jecks",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:cov": "turbo run test:cov",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
    "db:generate": "pnpm --filter @jecks/db generate",
    "db:migrate": "pnpm --filter @jecks/db migrate",
    "db:push": "pnpm --filter @jecks/db push",
    "db:seed": "pnpm --filter @jecks/db seed",
    "db:studio": "pnpm --filter @jecks/db studio",
    "db:reset": "pnpm --filter @jecks/db reset",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml --env-file .env up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml --env-file .env down",
    "docker:logs": "docker compose -f infra/docker/docker-compose.yml --env-file .env logs -f",
    "e2e": "pnpm --filter @jecks/e2e e2e",
    "e2e:install": "pnpm --filter @jecks/e2e install:browsers",
    "load": "k6 run e2e/load/catalog.js",
    "e2e:ui": "pnpm --filter @jecks/e2e e2e:ui",
    "test:integration": "pnpm --filter @jecks/api test:integration"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.1.3",
    "typescript": "^5.5.4"
  }
}
