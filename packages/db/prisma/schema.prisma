// Jeck's — PostgreSQL schema. Implements PRD Section 8.
//
// Conventions, applied without exception:
//   * ids are UUID v7 (time-sortable), generated by Prisma
//   * money is BigInt minor units (centimes) with a sibling `currency` where it aggregates
//   * translated copy is Json shaped { "fr": "...", "ar": "...", "en": "..." }
//   * timestamps are UTC; reporting converts to Africa/Algiers at the edge
//   * `deletedAt` marks a soft delete wherever losing history would hurt

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native"]
  previewFeatures = ["postgresqlExtensions", "fullTextSearchPostgres"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, pg_trgm, unaccent]
}

// ---------------------------------------------------------------------------
// Enums — mirrored in packages/shared/src/enums/index.ts
// ---------------------------------------------------------------------------

enum UserType {
  STAFF
  CUSTOMER
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MediaKind {
  IMAGE
  VIDEO
  MODEL_3D
  DOCUMENT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURN_REQUESTED
  RETURNED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  AUTHORIZED
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentMethod {
  COD
  CARD
  BANK_TRANSFER
  LOYALTY
}

enum DeliveryType {
  HOME
  STOP_DESK
}

enum ShipmentStatus {
  CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
  CANCELLED
}

enum DeliveryFailureReason {
  NO_ANSWER
  REFUSED
  WRONG_ADDRESS
  CUSTOMER_ABSENT
  RESCHEDULED
  DAMAGED
  OTHER
}

enum CallOutcome {
  CONFIRMED
  NO_ANSWER
  CANCELLED
  CALL_BACK
  WRONG_NUMBER
}

enum StockMovementReason {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  TRANSFER
  DAMAGED
  STOCK_COUNT
  RESERVATION
  RELEASE
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
  BUY_X_GET_Y
  BUNDLE_PRICE
  TIERED
}

enum PromotionScope {
  ORDER
  PRODUCT
  VARIANT
  COLLECTION
  CATEGORY
  SHIPPING
}

enum OrderSource {
  WEB
  PHONE
  INSTAGRAM
  FACEBOOK
  TIKTOK
  WHATSAPP
  ADMIN
}

enum ReturnCondition {
  RESELLABLE
  DAMAGED
  MISSING_PARTS
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum CustomerSegment {
  NEW
  RETURNING
  VIP
  AT_RISK
  BLACKLISTED
}

enum NotificationChannel {
  SMS
  EMAIL
  WHATSAPP
  TELEGRAM
  IN_APP
}

enum CollectionRuleField {
  TAG
  CATEGORY
  BRAND
  PRICE
  DISCOUNT
  STOCK
  CREATED_AT
  TITLE
}

enum RuleOperator {
  EQUALS
  NOT_EQUALS
  CONTAINS
  GREATER_THAN
  LESS_THAN
  IN
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DeliveryRunStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SettlementStatus {
  OPEN
  SENT
  PAID
  DISPUTED
}

// ---------------------------------------------------------------------------
// Identity & access — PRD F-AD-92
// ---------------------------------------------------------------------------

model User {
  id                String    @id @default(uuid(7)) @db.Uuid
  type              UserType  @default(STAFF)
  name              String    @db.VarChar(120)
  email             String?   @unique @db.VarChar(255)
  phone             String?   @unique @db.VarChar(20)
  passwordHash      String?   @db.VarChar(255)
  avatarMediaId     String?   @db.Uuid
  locale            String    @default("fr") @db.VarChar(5)
  active            Boolean   @default(true)
  twoFactorSecret   String?   @db.VarChar(255)
  twoFactorEnabled  Boolean   @default(false)
  lastLoginAt       DateTime?
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  roles            UserRole[]
  sessions         Session[]
  apiKeys          ApiKey[]
  driverProfile    Driver?
  customerProfile  Customer?
  auditLogs        AuditLog[]
  orderNotes       OrderNote[]
  callLogs         CallLog[]
  agentOrders      Order[]           @relation("OrderAgent")
  orderEvents      OrderEvent[]
  stockMovements   StockMovement[]
  expenses         Expense[]
  notifications    Notification[]
  invitationsSent  StaffInvitation[] @relation("InvitedBy")
  avatar           Media?            @relation("UserAvatar", fields: [avatarMediaId], references: [id])

  @@index([type, active])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  slug        String   @unique @db.VarChar(48)
  name        Json
  description String?  @db.VarChar(255)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]
  invitations StaffInvitation[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique @db.VarChar(64)
  group       String   @db.VarChar(48)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique @db.VarChar(255)
  userAgent        String?   @db.VarChar(400)
  ip               String?   @db.VarChar(64)
  expiresAt        DateTime
  revokedAt        DateTime?
  /// Set when this session was rotated, so a replayed refresh token is detectable.
  replacedById     String?   @db.Uuid
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model OtpCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  phone     String    @db.VarChar(20)
  codeHash  String    @db.VarChar(255)
  purpose   String    @db.VarChar(24)
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  ip        String?   @db.VarChar(64)
  createdAt DateTime  @default(now())

  @@index([phone, purpose, expiresAt])
  @@map("otp_codes")
}

model ApiKey {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String?   @db.Uuid
  name        String    @db.VarChar(120)
  keyHash     String    @unique @db.VarChar(255)
  prefix      String    @db.VarChar(12)
  scopes      String[]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("api_keys")
}

model StaffInvitation {
  id          String    @id @default(uuid(7)) @db.Uuid
  email       String    @db.VarChar(255)
  name        String    @db.VarChar(120)
  tokenHash   String    @unique @db.VarChar(255)
  roleId      String    @db.Uuid
  invitedById String    @db.Uuid
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  role      Role @relation(fields: [roleId], references: [id])
  invitedBy User @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([email])
  @@map("staff_invitations")
}

// ---------------------------------------------------------------------------
// Customers — PRD Section 5.5
// ---------------------------------------------------------------------------

model CustomerGroup {
  id             String   @id @default(uuid(7)) @db.Uuid
  name           Json
  slug           String   @unique @db.VarChar(48)
  /// Percentage taken off list price for this group (F-AD-41). 0 = no group pricing.
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customers  Customer[]
  promotions PromotionCustomerGroup[]

  @@map("customer_groups")
}

model Customer {
  id           String   @id @default(uuid(7)) @db.Uuid
  /// E.164, the primary identifier of PRD Section 3.
  phone        String   @unique @db.VarChar(20)
  altPhone     String?  @db.VarChar(20)
  fullName     String   @db.VarChar(120)
  email        String?  @db.VarChar(255)
  userId       String?  @unique @db.Uuid
  groupId      String?  @db.Uuid
  locale       String   @default("fr") @db.VarChar(5)
  loyaltyPoints Int     @default(0)
  blacklisted  Boolean  @default(false)
  blacklistReason String? @db.VarChar(255)
  acceptsMarketing Boolean @default(false)
  segment      CustomerSegment @default(NEW)

  // Cached rollups so customer lists and the risk score do not aggregate on read.
  ordersCount       Int      @default(0)
  deliveredCount    Int      @default(0)
  failedCount       Int      @default(0)
  cancelledCount    Int      @default(0)
  lifetimeValue     BigInt   @default(0)
  lastOrderAt       DateTime?
  firstOrderAt      DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user                User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  group               CustomerGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  addresses           CustomerAddress[]
  notes               CustomerNote[]
  orders              Order[]
  carts               Cart[]
  reviews             Review[]
  loyaltyTransactions LoyaltyTransaction[]
  promoUsages         PromoUsage[]
  stockNotifications  StockNotification[]
  abandonedCarts      AbandonedCart[]
  wishlistItems       WishlistItem[]

  @@index([segment, createdAt])
  @@index([blacklisted])
  @@map("customers")
}

model CustomerAddress {
  id           String       @id @default(uuid(7)) @db.Uuid
  customerId   String       @db.Uuid
  label        String?      @db.VarChar(48)
  fullName     String       @db.VarChar(120)
  phone        String       @db.VarChar(20)
  wilayaCode   Int
  communeId    String       @db.Uuid
  address      String?      @db.VarChar(400)
  deliveryType DeliveryType @default(HOME)
  pickupPointId String?     @db.Uuid
  isDefault    Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  wilaya      Wilaya       @relation(fields: [wilayaCode], references: [code])
  commune     Commune      @relation(fields: [communeId], references: [id])
  pickupPoint PickupPoint? @relation(fields: [pickupPointId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@map("customer_addresses")
}

model CustomerNote {
  id         String   @id @default(uuid(7)) @db.Uuid
  customerId String   @db.Uuid
  authorId   String?  @db.Uuid
  body       String   @db.Text
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@map("customer_notes")
}

model WishlistItem {
  id         String   @id @default(uuid(7)) @db.Uuid
  customerId String   @db.Uuid
  productId  String   @db.Uuid
  variantId  String?  @db.Uuid
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant  Variant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId, variantId])
  @@map("wishlist_items")
}

// ---------------------------------------------------------------------------
// Catalog — PRD Section 5.2
// ---------------------------------------------------------------------------

model Brand {
  id          String    @id @default(uuid(7)) @db.Uuid
  name        String    @db.VarChar(120)
  slug        String    @unique @db.VarChar(96)
  description Json?
  logoMediaId String?   @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  logo     Media?    @relation("BrandLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
  products Product[]

  @@map("brands")
}

model Category {
  id             String    @id @default(uuid(7)) @db.Uuid
  parentId       String?   @db.Uuid
  name           Json
  slug           String    @unique @db.VarChar(96)
  description    Json?
  /// Materialized ancestor path, e.g. "/caps/truckers/" — see DECISIONS D09.
  path           String    @default("/") @db.VarChar(400)
  depth          Int       @default(0)
  position       Int       @default(0)
  mediaId        String?   @db.Uuid
  seoTitle       Json?
  seoDescription Json?
  published      Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  parent     Category?              @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   Category[]             @relation("CategoryTree")
  media      Media?                 @relation("CategoryMedia", fields: [mediaId], references: [id], onDelete: SetNull)
  products   Product[]
  sizeGuides SizeGuide[]
  promotions PromotionCategory[]

  @@index([parentId, position])
  @@index([path])
  @@map("categories")
}

model Collection {
  id             String    @id @default(uuid(7)) @db.Uuid
  name           Json
  slug           String    @unique @db.VarChar(96)
  description    Json?
  /// Smart collections are populated by `rules`; manual ones by `products`.
  isSmart        Boolean   @default(false)
  matchAll       Boolean   @default(true)
  mediaId        String?   @db.Uuid
  heroMediaId    String?   @db.Uuid
  position       Int       @default(0)
  published      Boolean   @default(true)
  seoTitle       Json?
  seoDescription Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  media      Media?                @relation("CollectionMedia", fields: [mediaId], references: [id], onDelete: SetNull)
  hero       Media?                @relation("CollectionHero", fields: [heroMediaId], references: [id], onDelete: SetNull)
  rules      CollectionRule[]
  products   CollectionProduct[]
  promotions PromotionCollection[]
  homeSections HomeSection[]

  @@map("collections")
}

model CollectionRule {
  id           String              @id @default(uuid(7)) @db.Uuid
  collectionId String              @db.Uuid
  field        CollectionRuleField
  operator     RuleOperator
  value        String              @db.VarChar(240)
  createdAt    DateTime            @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@map("collection_rules")
}

model CollectionProduct {
  collectionId String   @db.Uuid
  productId    String   @db.Uuid
  position     Int      @default(0)
  /// Merchandising pin — keeps a product at the top of the grid (F-AD-13).
  pinned       Boolean  @default(false)
  createdAt    DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([collectionId, pinned, position])
  @@map("collection_products")
}

model Tag {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      Json
  slug      String   @unique @db.VarChar(64)
  createdAt DateTime @default(now())

  products ProductTag[]

  @@map("tags")
}

model ProductTag {
  productId String @db.Uuid
  tagId     String @db.Uuid

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@map("product_tags")
}

model SizeGuide {
  id         String   @id @default(uuid(7)) @db.Uuid
  name       Json
  /// Rich HTML table, per locale.
  body       Json
  categoryId String?  @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  products Product[]

  @@map("size_guides")
}

model Product {
  id                String        @id @default(uuid(7)) @db.Uuid
  name              Json
  slug              String        @unique @db.VarChar(96)
  description       Json?
  shortDescription  Json?
  status            ProductStatus @default(DRAFT)
  brandId           String?       @db.Uuid
  categoryId        String?       @db.Uuid
  sizeGuideId       String?       @db.Uuid
  styleLabel        String?       @db.VarChar(64)
  seoTitle          Json?
  seoDescription    Json?
  publishedAt       DateTime?
  trackInventory    Boolean       @default(true)
  allowBackorder    Boolean       @default(false)
  lowStockThreshold Int           @default(5)
  shippingClass     String?       @db.VarChar(64)

  // Denormalized so collection grids and sorts never touch the variants table.
  minPrice        BigInt   @default(0)
  maxPrice        BigInt   @default(0)
  maxCompareAt    BigInt?
  totalStock      Int      @default(0)
  ratingAverage   Decimal  @default(0) @db.Decimal(3, 2)
  ratingCount     Int      @default(0)
  salesCount      Int      @default(0)
  viewsCount      Int      @default(0)

  /// Weighted tsvector, a generated column created in migration 20260909120500.
  /// Prisma only needs to know it exists; the expression lives in SQL.
  searchVector Unsupported("tsvector")? @map("search_vector")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  brand              Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sizeGuide          SizeGuide?          @relation(fields: [sizeGuideId], references: [id], onDelete: SetNull)
  options            ProductOption[]
  variants           Variant[]
  media              ProductMedia[]
  tags               ProductTag[]
  attributes         ProductAttribute[]
  collections        CollectionProduct[]
  reviews            Review[]
  relatedFrom        RelatedProduct[]    @relation("RelatedSource")
  relatedTo          RelatedProduct[]    @relation("RelatedTarget")
  bundleItems        BundleItem[]
  stockNotifications StockNotification[]
  wishlistItems      WishlistItem[]
  promotions         PromotionProduct[]
  homeSections       HomeSection[]

  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@index([salesCount(sort: Desc)])
  @@map("products")
}

model ProductOption {
  id        String   @id @default(uuid(7)) @db.Uuid
  productId String   @db.Uuid
  name      Json
  /// "color" | "size" | free text — drives the swatch renderer on the PDP.
  kind      String   @default("text") @db.VarChar(24)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@index([productId, position])
  @@map("product_options")
}

model ProductOptionValue {
  id        String   @id @default(uuid(7)) @db.Uuid
  optionId  String   @db.Uuid
  name      Json
  swatchHex String?  @db.VarChar(7)
  mediaId   String?  @db.Uuid
  position  Int      @default(0)
  createdAt DateTime @default(now())

  option   ProductOption        @relation(fields: [optionId], references: [id], onDelete: Cascade)
  media    Media?               @relation("OptionSwatch", fields: [mediaId], references: [id], onDelete: SetNull)
  variants VariantOptionValue[]

  @@index([optionId, position])
  @@map("product_option_values")
}

model Variant {
  id             String    @id @default(uuid(7)) @db.Uuid
  productId      String    @db.Uuid
  sku            String    @unique @db.VarChar(64)
  barcode        String?   @db.VarChar(64)
  name           String?   @db.VarChar(160)
  price          BigInt
  compareAtPrice BigInt?
  /// Cost at the time of the last purchase receipt — feeds COGS (F-AD-70).
  costPrice      BigInt    @default(0)
  currency       String    @default("DZD") @db.Char(3)
  weightGrams    Int       @default(0)
  position       Int       @default(0)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  product            Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues       VariantOptionValue[]
  media              VariantMedia[]
  inventoryLevels    InventoryLevel[]
  stockMovements     StockMovement[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  purchaseOrderItems PurchaseOrderItem[]
  stockCountItems    StockCountItem[]
  priceSchedules     PriceSchedule[]
  stockNotifications StockNotification[]
  bundleItems        BundleItem[]
  wishlistItems      WishlistItem[]
  promotions         PromotionVariant[]

  @@index([productId, position])
  @@map("variants")
}

model VariantOptionValue {
  variantId     String @db.Uuid
  optionValueId String @db.Uuid

  variant     Variant            @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@map("variant_option_values")
}

model MediaFolder {
  id        String   @id @default(uuid(7)) @db.Uuid
  parentId  String?  @db.Uuid
  name      String   @db.VarChar(120)
  createdAt DateTime @default(now())

  parent   MediaFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children MediaFolder[] @relation("FolderTree")
  media    Media[]

  @@map("media_folders")
}

model Media {
  id          String    @id @default(uuid(7)) @db.Uuid
  kind        MediaKind @default(IMAGE)
  folderId    String?   @db.Uuid
  /// Storage key, resolved to a URL by the active StorageProvider.
  storageKey  String    @db.VarChar(400)
  fileName    String    @db.VarChar(255)
  mimeType    String    @db.VarChar(120)
  sizeBytes   Int       @default(0)
  width       Int?
  height      Int?
  durationMs  Int?
  /// Generated responsive renditions: [{ width, key, format }].
  renditions  Json?
  /// Poster frame for videos and GLB models (PRD Section 6.3).
  posterKey   String?   @db.VarChar(400)
  blurhash    String?   @db.VarChar(64)
  alt         Json?
  checksum    String?   @db.VarChar(64)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  folder            MediaFolder?         @relation(fields: [folderId], references: [id], onDelete: SetNull)
  productMedia      ProductMedia[]
  variantMedia      VariantMedia[]
  reviewMedia       ReviewMedia[]
  optionSwatches    ProductOptionValue[] @relation("OptionSwatch")
  brandLogos        Brand[]              @relation("BrandLogo")
  categoryMedia     Category[]           @relation("CategoryMedia")
  collectionMedia   Collection[]         @relation("CollectionMedia")
  collectionHeroes  Collection[]         @relation("CollectionHero")
  bannerMedia       Banner[]
  homeSectionMedia  HomeSection[]
  userAvatars       User[]               @relation("UserAvatar")
  pageHeroes        Page[]

  @@index([kind, createdAt])
  @@map("media")
}

model ProductMedia {
  productId String   @db.Uuid
  mediaId   String   @db.Uuid
  position  Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([productId, mediaId])
  @@index([productId, position])
  @@map("product_media")
}

model VariantMedia {
  variantId String   @db.Uuid
  mediaId   String   @db.Uuid
  position  Int      @default(0)
  createdAt DateTime @default(now())

  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([variantId, mediaId])
  @@map("variant_media")
}

model Attribute {
  id        String   @id @default(uuid(7)) @db.Uuid
  key       String   @unique @db.VarChar(64)
  name      Json
  /// "text" | "number" | "select" — controls the admin editor widget.
  kind      String   @default("text") @db.VarChar(24)
  options   Json?
  filterable Boolean @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  products ProductAttribute[]

  @@map("attributes")
}

model ProductAttribute {
  productId   String @db.Uuid
  attributeId String @db.Uuid
  value       Json

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([productId, attributeId])
  @@map("product_attributes")
}

model RelatedProduct {
  productId        String   @db.Uuid
  relatedProductId String   @db.Uuid
  /// "related" | "complete_the_look" | "upsell"
  kind             String   @default("related") @db.VarChar(24)
  position         Int      @default(0)

  product        Product @relation("RelatedSource", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct Product @relation("RelatedTarget", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@id([productId, relatedProductId, kind])
  @@map("related_products")
}

model Bundle {
  id            String    @id @default(uuid(7)) @db.Uuid
  name          Json
  slug          String    @unique @db.VarChar(96)
  description   Json?
  /// Either a fixed bundle price or a percentage off the component total.
  bundlePrice   BigInt?
  discountPercent Decimal? @db.Decimal(5, 2)
  active        Boolean   @default(true)
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items BundleItem[]

  @@map("bundles")
}

model BundleItem {
  id        String  @id @default(uuid(7)) @db.Uuid
  bundleId  String  @db.Uuid
  productId String? @db.Uuid
  variantId String? @db.Uuid
  quantity  Int     @default(1)
  position  Int     @default(0)

  bundle  Bundle   @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant Variant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([bundleId])
  @@map("bundle_items")
}

model Review {
  id           String       @id @default(uuid(7)) @db.Uuid
  productId    String       @db.Uuid
  customerId   String?      @db.Uuid
  orderId      String?      @db.Uuid
  rating       Int
  title        String?      @db.VarChar(120)
  body         String       @db.Text
  authorName   String       @db.VarChar(80)
  status       ReviewStatus @default(PENDING)
  /// True when the reviewer has a delivered order containing this product.
  verified     Boolean      @default(false)
  reply        String?      @db.Text
  repliedAt    DateTime?
  helpfulCount Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  product  Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  media    ReviewMedia[]

  @@index([productId, status, createdAt])
  @@map("reviews")
}

model ReviewMedia {
  reviewId String @db.Uuid
  mediaId  String @db.Uuid
  position Int    @default(0)

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  media  Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([reviewId, mediaId])
  @@map("review_media")
}

model StockNotification {
  id         String    @id @default(uuid(7)) @db.Uuid
  productId  String    @db.Uuid
  variantId  String?   @db.Uuid
  customerId String?   @db.Uuid
  phone      String?   @db.VarChar(20)
  email      String?   @db.VarChar(255)
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant  Variant?  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([variantId, notifiedAt])
  @@map("stock_notifications")
}

// ---------------------------------------------------------------------------
// Inventory & suppliers — PRD Section 5.6
// ---------------------------------------------------------------------------

model Location {
  id         String   @id @default(uuid(7)) @db.Uuid
  name       String   @db.VarChar(120)
  code       String   @unique @db.VarChar(24)
  address    String?  @db.VarChar(400)
  wilayaCode Int?
  isDefault  Boolean  @default(false)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  wilaya          Wilaya?          @relation(fields: [wilayaCode], references: [code], onDelete: SetNull)
  inventoryLevels InventoryLevel[]
  stockMovements  StockMovement[]
  purchaseOrders  PurchaseOrder[]
  stockCounts     StockCount[]

  @@map("locations")
}

model InventoryLevel {
  id         String   @id @default(uuid(7)) @db.Uuid
  variantId  String   @db.Uuid
  locationId String   @db.Uuid
  onHand     Int      @default(0)
  /// Held by unconfirmed orders; `available` is onHand - reserved.
  reserved   Int      @default(0)
  incoming   Int      @default(0)
  updatedAt  DateTime @updatedAt

  variant  Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([variantId, locationId])
  @@index([locationId])
  @@map("inventory_levels")
}

model StockMovement {
  id         String              @id @default(uuid(7)) @db.Uuid
  variantId  String              @db.Uuid
  locationId String              @db.Uuid
  /// Signed: negative for a sale, positive for a receipt or restock.
  quantity   Int
  reason     StockMovementReason
  /// Free-form pointer to whatever caused the movement (order id, PO id…).
  referenceType String?          @db.VarChar(40)
  referenceId   String?          @db.Uuid
  note       String?             @db.VarChar(400)
  actorId    String?             @db.Uuid
  /// Stock level after applying this movement — makes the ledger auditable.
  balanceAfter Int
  createdAt  DateTime            @default(now())

  variant  Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  actor    User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

model Supplier {
  id          String    @id @default(uuid(7)) @db.Uuid
  name        String    @db.VarChar(160)
  contactName String?   @db.VarChar(120)
  phone       String?   @db.VarChar(20)
  email       String?   @db.VarChar(255)
  address     String?   @db.VarChar(400)
  note        String?   @db.Text
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model PurchaseOrder {
  id           String              @id @default(uuid(7)) @db.Uuid
  number       String              @unique @db.VarChar(32)
  supplierId   String              @db.Uuid
  locationId   String              @db.Uuid
  status       PurchaseOrderStatus @default(DRAFT)
  currency     String              @default("DZD") @db.Char(3)
  subtotal     BigInt              @default(0)
  shippingCost BigInt              @default(0)
  otherCost    BigInt              @default(0)
  total        BigInt              @default(0)
  expectedAt   DateTime?
  orderedAt    DateTime?
  receivedAt   DateTime?
  note         String?             @db.Text
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  location Location            @relation(fields: [locationId], references: [id])
  items    PurchaseOrderItem[]

  @@index([status, createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String @id @default(uuid(7)) @db.Uuid
  purchaseOrderId String @db.Uuid
  variantId       String @db.Uuid
  quantity        Int
  receivedQuantity Int   @default(0)
  unitCost        BigInt
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant       Variant       @relation(fields: [variantId], references: [id])

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

model StockCount {
  id         String    @id @default(uuid(7)) @db.Uuid
  locationId String    @db.Uuid
  name       String    @db.VarChar(120)
  status     String    @default("OPEN") @db.VarChar(16)
  startedAt  DateTime  @default(now())
  closedAt   DateTime?
  note       String?   @db.Text

  location Location         @relation(fields: [locationId], references: [id])
  items    StockCountItem[]

  @@map("stock_counts")
}

model StockCountItem {
  id             String @id @default(uuid(7)) @db.Uuid
  stockCountId   String @db.Uuid
  variantId      String @db.Uuid
  expectedQuantity Int
  countedQuantity  Int?
  /// countedQuantity - expectedQuantity, stored so the variance report is a plain read.
  variance         Int?
  createdAt      DateTime @default(now())

  stockCount StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  variant    Variant    @relation(fields: [variantId], references: [id])

  @@unique([stockCountId, variantId])
  @@map("stock_count_items")
}

// ---------------------------------------------------------------------------
// Promotions — PRD Section 5.3
// ---------------------------------------------------------------------------

model Promotion {
  id          String         @id @default(uuid(7)) @db.Uuid
  name        String         @db.VarChar(120)
  description String?        @db.VarChar(500)
  type        PromotionType
  scope       PromotionScope @default(ORDER)
  /// null = automatic promotion applied with no code.
  code        String?        @unique @db.VarChar(48)

  percentOff  Decimal? @db.Decimal(5, 2)
  amountOff   BigInt?
  bundlePrice BigInt?
  /// { buyQuantity, getQuantity, getDiscountPercent } for BUY_X_GET_Y.
  buyXGetY    Json?
  /// [{ minSubtotal, percentOff }] for TIERED, ordered ascending.
  tiers       Json?

  minSubtotal      BigInt?
  minQuantity      Int?
  firstOrderOnly   Boolean  @default(false)
  wilayaCodes      Int[]

  usageLimitTotal       Int?
  usageLimitPerCustomer Int?
  usageCount            Int  @default(0)

  stackable     Boolean   @default(false)
  priority      Int       @default(100)
  startsAt      DateTime?
  endsAt        DateTime?
  active        Boolean   @default(true)
  showCountdown Boolean   @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  codes          PromoCode[]
  usages         PromoUsage[]
  products       PromotionProduct[]
  variants       PromotionVariant[]
  collections    PromotionCollection[]
  categories     PromotionCategory[]
  customerGroups PromotionCustomerGroup[]
  affiliates     Affiliate[]

  @@index([active, startsAt, endsAt])
  @@index([priority])
  @@map("promotions")
}

model PromotionProduct {
  promotionId String @db.Uuid
  productId   String @db.Uuid

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@map("promotion_products")
}

model PromotionVariant {
  promotionId String @db.Uuid
  variantId   String @db.Uuid

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  variant   Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([promotionId, variantId])
  @@map("promotion_variants")
}

model PromotionCollection {
  promotionId  String @db.Uuid
  collectionId String @db.Uuid

  promotion  Promotion  @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([promotionId, collectionId])
  @@map("promotion_collections")
}

model PromotionCategory {
  promotionId String @db.Uuid
  categoryId  String @db.Uuid

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([promotionId, categoryId])
  @@map("promotion_categories")
}

model PromotionCustomerGroup {
  promotionId String @db.Uuid
  groupId     String @db.Uuid

  promotion Promotion     @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  group     CustomerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([promotionId, groupId])
  @@map("promotion_customer_groups")
}

model PromoCode {
  id          String    @id @default(uuid(7)) @db.Uuid
  promotionId String    @db.Uuid
  code        String    @unique @db.VarChar(48)
  usageLimit  Int       @default(1)
  usageCount  Int       @default(0)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  promotion Promotion    @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  usages    PromoUsage[]

  @@index([promotionId])
  @@map("promo_codes")
}

model PromoUsage {
  id          String   @id @default(uuid(7)) @db.Uuid
  promotionId String   @db.Uuid
  promoCodeId String?  @db.Uuid
  orderId     String?  @db.Uuid
  customerId  String?  @db.Uuid
  /// Discount actually granted, for the promo performance report (F-AD-80).
  amount      BigInt   @default(0)
  createdAt   DateTime @default(now())

  promotion Promotion  @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  promoCode PromoCode? @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  order     Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customer  Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([promotionId, createdAt])
  @@index([customerId])
  @@map("promo_usages")
}

model PriceSchedule {
  id             String    @id @default(uuid(7)) @db.Uuid
  variantId      String    @db.Uuid
  price          BigInt
  compareAtPrice BigInt?
  startsAt       DateTime
  endsAt         DateTime?
  appliedAt      DateTime?
  revertedAt     DateTime?
  createdAt      DateTime  @default(now())

  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([startsAt, appliedAt])
  @@map("price_schedules")
}

// ---------------------------------------------------------------------------
// Carts & orders — PRD Sections 4.5 and 5.4
// ---------------------------------------------------------------------------

model Cart {
  id          String    @id @default(uuid(7)) @db.Uuid
  /// Opaque token held by the guest browser (F-ST-41).
  token       String    @unique @db.VarChar(128)
  customerId  String?   @db.Uuid
  currency    String    @default("DZD") @db.Char(3)
  promoCode   String?   @db.VarChar(48)
  wilayaCode  Int?
  deliveryType DeliveryType?
  note        String?   @db.VarChar(500)
  convertedOrderId String? @db.Uuid
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    CartItem[]
  abandoned AbandonedCart?

  @@index([customerId])
  @@index([updatedAt])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid(7)) @db.Uuid
  cartId    String   @db.Uuid
  variantId String   @db.Uuid
  bundleId  String?  @db.Uuid
  quantity  Int      @default(1)
  /// Snapshot so a price change mid-session is visible rather than silent.
  unitPrice BigInt
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId, bundleId])
  @@map("cart_items")
}

model Order {
  id     String @id @default(uuid(7)) @db.Uuid
  /// Human-facing number, format JK-{YYMMDD}-{SEQ} (F-AD-91).
  number String @unique @db.VarChar(32)

  customerId String? @db.Uuid
  agentId    String? @db.Uuid

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  paymentMethod PaymentMethod @default(COD)
  source        OrderSource   @default(WEB)

  // Customer snapshot: an order must stay readable if the customer record changes.
  customerName  String  @db.VarChar(120)
  customerPhone String  @db.VarChar(20)
  customerAltPhone String? @db.VarChar(20)
  customerEmail String? @db.VarChar(255)

  // Shipping snapshot.
  wilayaCode    Int
  wilayaName    String       @db.VarChar(120)
  communeId     String?      @db.Uuid
  communeName   String?      @db.VarChar(160)
  deliveryType  DeliveryType @default(HOME)
  address       String?      @db.VarChar(400)
  pickupPointId String?      @db.Uuid
  pickupPointName String?    @db.VarChar(200)

  // Totals, all in minor units of `currency`.
  currency       String @default("DZD") @db.Char(3)
  itemsSubtotal  BigInt @default(0)
  discountTotal  BigInt @default(0)
  shippingTotal  BigInt @default(0)
  shippingCost   BigInt @default(0)
  loyaltyDiscount BigInt @default(0)
  taxTotal       BigInt @default(0)
  total          BigInt @default(0)
  /// Sum of order_items.unitCost * quantity, frozen at confirmation (F-AD-70).
  cogsTotal      BigInt @default(0)
  paidTotal      BigInt @default(0)
  refundedTotal  BigInt @default(0)

  weightGrams Int    @default(0)
  itemCount   Int    @default(0)

  note         String? @db.VarChar(500)
  internalNote String? @db.Text
  tags         String[]
  /// 0-100 COD fraud heuristic (F-AD-31): failed history, duplicates, blacklist.
  riskScore    Int     @default(0)

  utmSource   String? @db.VarChar(120)
  utmMedium   String? @db.VarChar(120)
  utmCampaign String? @db.VarChar(120)
  utmContent  String? @db.VarChar(120)
  utmTerm     String? @db.VarChar(120)
  /// Deduplicates retried POST /orders (PRD Section 10.3).
  idempotencyKey String? @unique @db.VarChar(128)
  ip             String? @db.VarChar(64)

  confirmedAt DateTime?
  packedAt    DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?
  returnedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  customer            Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  agent               User?                @relation("OrderAgent", fields: [agentId], references: [id], onDelete: SetNull)
  wilaya              Wilaya               @relation(fields: [wilayaCode], references: [code])
  commune             Commune?             @relation(fields: [communeId], references: [id], onDelete: SetNull)
  pickupPoint         PickupPoint?         @relation(fields: [pickupPointId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  events              OrderEvent[]
  notes               OrderNote[]
  callLogs            CallLog[]
  shipments           Shipment[]
  payments            Payment[]
  refunds             Refund[]
  returns             Return[]
  invoices            Invoice[]
  promoUsages         PromoUsage[]
  loyaltyTransactions LoyaltyTransaction[]
  runStops            DeliveryRunStop[]
  codCollections      CodCollection[]
  settlementLines     CourierSettlementLine[]
  ledgerEntries       LedgerEntry[]

  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([paymentStatus, status])
  @@index([wilayaCode, createdAt])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid(7)) @db.Uuid
  orderId   String  @db.Uuid
  variantId String? @db.Uuid
  bundleId  String? @db.Uuid

  // Snapshot of the variant at purchase time — the product may change or be deleted.
  productName Json
  variantName String? @db.VarChar(160)
  sku         String  @db.VarChar(64)
  mediaKey    String? @db.VarChar(400)

  quantity      Int
  unitPrice     BigInt
  /// Cost price frozen at purchase — never re-read from the variant (F-AD-70).
  unitCost      BigInt @default(0)
  unitCompareAt BigInt?
  /// Order-level discount allocated to this line, so per-product margin is exact.
  discountAmount BigInt @default(0)
  lineTotal      BigInt

  refundedQuantity Int @default(0)
  returnedQuantity Int @default(0)

  createdAt DateTime @default(now())

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     Variant?     @relation(fields: [variantId], references: [id], onDelete: SetNull)
  returnItems ReturnItem[]

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

model OrderEvent {
  id        String       @id @default(uuid(7)) @db.Uuid
  orderId   String       @db.Uuid
  actorId   String?      @db.Uuid
  /// null on creation; otherwise the status the order left.
  fromStatus OrderStatus?
  toStatus   OrderStatus?
  /// "status" | "payment" | "edit" | "note" | "shipment" | "system"
  kind      String       @default("status") @db.VarChar(24)
  reason    String?      @db.VarChar(500)
  metadata  Json?
  createdAt DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_events")
}

model OrderNote {
  id        String   @id @default(uuid(7)) @db.Uuid
  orderId   String   @db.Uuid
  authorId  String?  @db.Uuid
  body      String   @db.Text
  createdAt DateTime @default(now())

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_notes")
}

model CallLog {
  id         String      @id @default(uuid(7)) @db.Uuid
  orderId    String      @db.Uuid
  agentId    String?     @db.Uuid
  outcome    CallOutcome
  note       String?     @db.Text
  callBackAt DateTime?
  createdAt  DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  agent User? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([agentId, createdAt])
  @@map("call_logs")
}

model Return {
  id        String    @id @default(uuid(7)) @db.Uuid
  orderId   String    @db.Uuid
  number    String    @unique @db.VarChar(32)
  reason    String?   @db.VarChar(300)
  status    String    @default("REQUESTED") @db.VarChar(24)
  restock   Boolean   @default(true)
  note      String?   @db.Text
  processedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  order   Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items   ReturnItem[]
  refunds Refund[]

  @@index([orderId])
  @@map("returns")
}

model ReturnItem {
  id          String          @id @default(uuid(7)) @db.Uuid
  returnId    String          @db.Uuid
  orderItemId String          @db.Uuid
  quantity    Int
  condition   ReturnCondition @default(RESELLABLE)
  reason      String?         @db.VarChar(300)

  return    Return    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@index([returnId])
  @@map("return_items")
}

model Payment {
  id        String        @id @default(uuid(7)) @db.Uuid
  orderId   String        @db.Uuid
  method    PaymentMethod
  amount    BigInt
  currency  String        @default("DZD") @db.Char(3)
  /// "pending" | "captured" | "failed"
  status    String        @default("captured") @db.VarChar(24)
  provider  String?       @db.VarChar(48)
  providerRef String?     @db.VarChar(128)
  /// Gateway or courier fee deducted from this payment (F-AD-70).
  feeAmount BigInt        @default(0)
  receivedAt DateTime     @default(now())
  metadata  Json?
  createdAt DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([receivedAt])
  @@map("payments")
}

model Refund {
  id        String   @id @default(uuid(7)) @db.Uuid
  orderId   String   @db.Uuid
  returnId  String?  @db.Uuid
  amount    BigInt
  currency  String   @default("DZD") @db.Char(3)
  reason    String?  @db.VarChar(300)
  method    PaymentMethod @default(COD)
  actorId   String?  @db.Uuid
  createdAt DateTime @default(now())

  order  Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  return Return? @relation(fields: [returnId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("refunds")
}

model Invoice {
  id         String   @id @default(uuid(7)) @db.Uuid
  orderId    String   @db.Uuid
  number     String   @unique @db.VarChar(32)
  /// Storage key of the rendered PDF; served through a signed URL (10.8).
  storageKey String?  @db.VarChar(400)
  total      BigInt
  currency   String   @default("DZD") @db.Char(3)
  issuedAt   DateTime @default(now())
  createdAt  DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("invoices")
}

// ---------------------------------------------------------------------------
// Shipping & logistics — PRD Section 5.7
// ---------------------------------------------------------------------------

model Wilaya {
  code      Int      @id
  name      Json
  nameAscii String   @db.VarChar(120)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  communes      Commune[]
  shippingRates ShippingRate[]
  pickupPoints  PickupPoint[]
  orders        Order[]
  addresses     CustomerAddress[]
  locations     Location[]
  drivers       Driver[]

  @@map("wilayas")
}

model Commune {
  id         String   @id @default(uuid(7)) @db.Uuid
  wilayaCode Int
  name       Json
  nameAscii  String   @db.VarChar(160)
  postalCode String?  @db.VarChar(10)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  wilaya    Wilaya            @relation(fields: [wilayaCode], references: [code], onDelete: Cascade)
  orders    Order[]
  addresses CustomerAddress[]
  pickupPoints PickupPoint[]

  @@unique([wilayaCode, nameAscii])
  @@index([wilayaCode])
  @@map("communes")
}

model ShippingZone {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      Json
  /// Wilaya codes grouped into a pricing band (North, Highlands, South…).
  wilayaCodes Int[]
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rates ShippingRate[]

  @@map("shipping_zones")
}

model ShippingRate {
  id           String       @id @default(uuid(7)) @db.Uuid
  zoneId       String?      @db.Uuid
  /// A rate is either wilaya-specific or zone-wide; the specific one wins.
  wilayaCode   Int?
  courierId    String?      @db.Uuid
  deliveryType DeliveryType @default(HOME)
  price        BigInt
  /// What the courier or driver charges us — the shipping cost line of the P&L.
  cost         BigInt       @default(0)
  currency     String       @default("DZD") @db.Char(3)
  /// Weight allowance in grams before `extraPerKg` applies.
  freeWeightGrams Int       @default(1000)
  extraPerKg   BigInt       @default(0)
  freeShippingThreshold BigInt?
  etaMinDays   Int          @default(1)
  etaMaxDays   Int          @default(4)
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  zone    ShippingZone? @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  wilaya  Wilaya?       @relation(fields: [wilayaCode], references: [code], onDelete: Cascade)
  courier Courier?      @relation(fields: [courierId], references: [id], onDelete: Cascade)

  @@unique([wilayaCode, courierId, deliveryType])
  @@index([zoneId])
  @@map("shipping_rates")
}

model Courier {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @db.VarChar(120)
  slug      String   @unique @db.VarChar(48)
  /// Adapter key resolved by the CourierProvider registry: "manual" | "yalidine"…
  provider  String   @default("manual") @db.VarChar(48)
  phone     String?  @db.VarChar(20)
  email     String?  @db.VarChar(255)
  active    Boolean  @default(true)
  /// Percentage of the COD amount the courier keeps, on top of the shipping fee.
  codFeePercent Decimal @default(0) @db.Decimal(5, 2)
  settlementDays Int    @default(7)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  credentials  CourierCredential[]
  shipments    Shipment[]
  rates        ShippingRate[]
  settlements  CourierSettlement[]
  pickupPoints PickupPoint[]

  @@map("couriers")
}

model CourierCredential {
  id        String   @id @default(uuid(7)) @db.Uuid
  courierId String   @db.Uuid
  key       String   @db.VarChar(64)
  /// Encrypted at rest (PRD Section 10.8); never returned by the API.
  valueEnc  String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courier Courier @relation(fields: [courierId], references: [id], onDelete: Cascade)

  @@unique([courierId, key])
  @@map("courier_credentials")
}

model PickupPoint {
  id         String   @id @default(uuid(7)) @db.Uuid
  courierId  String?  @db.Uuid
  wilayaCode Int
  communeId  String?  @db.Uuid
  name       String   @db.VarChar(200)
  address    String   @db.VarChar(400)
  phone      String?  @db.VarChar(20)
  latitude   Decimal? @db.Decimal(9, 6)
  longitude  Decimal? @db.Decimal(9, 6)
  openingHours Json?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  courier   Courier?          @relation(fields: [courierId], references: [id], onDelete: SetNull)
  wilaya    Wilaya            @relation(fields: [wilayaCode], references: [code])
  commune   Commune?          @relation(fields: [communeId], references: [id], onDelete: SetNull)
  orders    Order[]
  addresses CustomerAddress[]

  @@index([wilayaCode, active])
  @@map("pickup_points")
}

model Vehicle {
  id         String   @id @default(uuid(7)) @db.Uuid
  plate      String   @unique @db.VarChar(24)
  label      String   @db.VarChar(120)
  /// "truck" | "van" | "motorbike"
  kind       String   @default("van") @db.VarChar(24)
  capacityKg Int      @default(0)
  active     Boolean  @default(true)
  note       String?  @db.VarChar(400)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  runs DeliveryRun[]

  @@map("vehicles")
}

model Driver {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @unique @db.Uuid
  phone      String   @db.VarChar(20)
  wilayaCode Int?
  licenseNo  String?  @db.VarChar(48)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  wilaya         Wilaya?         @relation(fields: [wilayaCode], references: [code], onDelete: SetNull)
  runs           DeliveryRun[]
  shipments      Shipment[]
  codCollections CodCollection[]

  @@map("drivers")
}

model DeliveryRun {
  id        String            @id @default(uuid(7)) @db.Uuid
  code      String            @unique @db.VarChar(32)
  date      DateTime          @db.Date
  driverId  String            @db.Uuid
  vehicleId String?           @db.Uuid
  status    DeliveryRunStatus @default(PLANNED)
  note      String?           @db.VarChar(500)
  startedAt DateTime?
  endedAt   DateTime?
  /// Cash the driver is expected to hand in for this run (F-AD-64).
  expectedCash  BigInt @default(0)
  collectedCash BigInt @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  driver  Driver            @relation(fields: [driverId], references: [id])
  vehicle Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  stops   DeliveryRunStop[]

  @@index([date, driverId])
  @@map("delivery_runs")
}

model DeliveryRunStop {
  id        String   @id @default(uuid(7)) @db.Uuid
  runId     String   @db.Uuid
  orderId   String   @db.Uuid
  position  Int      @default(0)
  status    String   @default("PENDING") @db.VarChar(24)
  failureReason DeliveryFailureReason?
  cashCollected BigInt  @default(0)
  note      String?  @db.VarChar(400)
  proofMediaId String? @db.Uuid
  arrivedAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  run   DeliveryRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  order Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([runId, orderId])
  @@index([runId, position])
  @@map("delivery_run_stops")
}

model Shipment {
  id        String         @id @default(uuid(7)) @db.Uuid
  orderId   String         @db.Uuid
  courierId String?        @db.Uuid
  driverId  String?        @db.Uuid
  status    ShipmentStatus @default(CREATED)
  trackingNumber String?   @db.VarChar(64)
  trackingUrl    String?   @db.VarChar(400)
  labelKey       String?   @db.VarChar(400)
  attempts  Int            @default(0)
  /// What we pay for this shipment; rolls into Order.shippingCost.
  cost      BigInt         @default(0)
  currency  String         @default("DZD") @db.Char(3)
  failureReason DeliveryFailureReason?
  shippedAt   DateTime?
  deliveredAt DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier Courier?        @relation(fields: [courierId], references: [id], onDelete: SetNull)
  driver  Driver?         @relation(fields: [driverId], references: [id], onDelete: SetNull)
  events  ShipmentEvent[]

  @@index([orderId])
  @@index([trackingNumber])
  @@index([status, updatedAt])
  @@map("shipments")
}

model ShipmentEvent {
  id         String         @id @default(uuid(7)) @db.Uuid
  shipmentId String         @db.Uuid
  status     ShipmentStatus
  /// Raw label from the courier, kept because adapters map imperfectly.
  rawStatus  String?        @db.VarChar(120)
  message    String?        @db.VarChar(500)
  occurredAt DateTime       @default(now())
  createdAt  DateTime       @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
  @@map("shipment_events")
}

model CodCollection {
  id        String   @id @default(uuid(7)) @db.Uuid
  orderId   String   @db.Uuid
  driverId  String?  @db.Uuid
  courierId String?  @db.Uuid
  amount    BigInt
  currency  String   @default("DZD") @db.Char(3)
  collectedAt DateTime @default(now())
  /// Set once the cash is counted in at the office or settled by the courier.
  reconciledAt DateTime?
  note      String?  @db.VarChar(400)
  createdAt DateTime @default(now())

  order  Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@index([driverId, collectedAt])
  @@index([reconciledAt])
  @@map("cod_collections")
}

model CourierSettlement {
  id        String           @id @default(uuid(7)) @db.Uuid
  courierId String           @db.Uuid
  reference String           @unique @db.VarChar(48)
  periodFrom DateTime        @db.Date
  periodTo   DateTime        @db.Date
  status    SettlementStatus @default(OPEN)
  /// COD collected by the courier on our behalf.
  grossAmount BigInt         @default(0)
  /// Shipping and COD fees the courier deducts.
  feesAmount  BigInt         @default(0)
  netAmount   BigInt         @default(0)
  /// netAmount minus what actually landed — chased in the admin (F-AD-64).
  paidAmount  BigInt         @default(0)
  difference  BigInt         @default(0)
  currency   String          @default("DZD") @db.Char(3)
  paidAt     DateTime?
  note       String?         @db.Text
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  courier Courier                 @relation(fields: [courierId], references: [id])
  lines   CourierSettlementLine[]

  @@index([courierId, periodTo])
  @@map("courier_settlements")
}

model CourierSettlementLine {
  id           String @id @default(uuid(7)) @db.Uuid
  settlementId String @db.Uuid
  orderId      String @db.Uuid
  codAmount    BigInt @default(0)
  feeAmount    BigInt @default(0)
  netAmount    BigInt @default(0)
  note         String? @db.VarChar(300)

  settlement CourierSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  order      Order             @relation(fields: [orderId], references: [id])

  @@unique([settlementId, orderId])
  @@map("courier_settlement_lines")
}

// ---------------------------------------------------------------------------
// Finance — PRD Section 5.8
// ---------------------------------------------------------------------------

model ExpenseCategory {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      Json
  slug      String   @unique @db.VarChar(48)
  color     String?  @db.VarChar(7)
  createdAt DateTime @default(now())

  expenses Expense[]

  @@map("expense_categories")
}

model Expense {
  id          String    @id @default(uuid(7)) @db.Uuid
  categoryId  String?   @db.Uuid
  label       String    @db.VarChar(200)
  amount      BigInt
  currency    String    @default("DZD") @db.Char(3)
  incurredAt  DateTime  @db.Date
  /// null for one-off; otherwise "monthly" | "weekly" | "yearly".
  recurrence  String?   @db.VarChar(16)
  recurrenceEndsAt DateTime? @db.Date
  parentId    String?   @db.Uuid
  attachmentKey String? @db.VarChar(400)
  note        String?   @db.Text
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  category  ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  parent    Expense?         @relation("ExpenseSeries", fields: [parentId], references: [id], onDelete: SetNull)
  children  Expense[]        @relation("ExpenseSeries")

  @@index([incurredAt])
  @@index([categoryId, incurredAt])
  @@map("expenses")
}

model AdSpend {
  id        String   @id @default(uuid(7)) @db.Uuid
  platform  String   @db.VarChar(48)
  campaign  String?  @db.VarChar(160)
  spentOn   DateTime @db.Date
  amount    BigInt
  currency  String   @default("DZD") @db.Char(3)
  impressions Int?
  clicks    Int?
  note      String?  @db.VarChar(400)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platform, campaign, spentOn])
  @@index([spentOn])
  @@map("ad_spend")
}

/// Double-entry-lite journal: one row per money movement, signed by direction.
model LedgerEntry {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// "sale" | "cod_collection" | "refund" | "expense" | "settlement" | "adjustment"
  kind      String   @db.VarChar(32)
  /// "cash" | "bank" | "courier" | "customer"
  account   String   @db.VarChar(32)
  /// Positive = money in, negative = money out.
  amount    BigInt
  currency  String   @default("DZD") @db.Char(3)
  orderId   String?  @db.Uuid
  referenceType String? @db.VarChar(40)
  referenceId   String? @db.Uuid
  occurredAt DateTime @default(now())
  note      String?  @db.VarChar(400)
  createdAt DateTime @default(now())

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([account, occurredAt])
  @@index([kind, occurredAt])
  @@map("ledger_entries")
}

/// Pre-aggregated dashboard rows — PRD Section 10.7, rebuilt nightly by the worker.
model DailyStat {
  day            DateTime @id @db.Date
  ordersCount    Int      @default(0)
  deliveredCount Int      @default(0)
  failedCount    Int      @default(0)
  cancelledCount Int      @default(0)
  revenue        BigInt   @default(0)
  cogs           BigInt   @default(0)
  shippingCost   BigInt   @default(0)
  discounts      BigInt   @default(0)
  refunds        BigInt   @default(0)
  expenses       BigInt   @default(0)
  adSpend        BigInt   @default(0)
  grossProfit    BigInt   @default(0)
  netProfit      BigInt   @default(0)
  newCustomers   Int      @default(0)
  sessions       Int      @default(0)
  currency       String   @default("DZD") @db.Char(3)
  computedAt     DateTime @default(now())

  @@map("daily_stats")
}

// ---------------------------------------------------------------------------
// Content & storefront chrome — PRD Section 5.10
// ---------------------------------------------------------------------------

model Page {
  id             String    @id @default(uuid(7)) @db.Uuid
  slug           String    @unique @db.VarChar(96)
  title          Json
  body           Json
  excerpt        Json?
  heroMediaId    String?   @db.Uuid
  seoTitle       Json?
  seoDescription Json?
  published      Boolean   @default(false)
  publishedAt    DateTime?
  /// "page" | "post" | "legal"
  kind           String    @default("page") @db.VarChar(16)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  hero Media? @relation(fields: [heroMediaId], references: [id], onDelete: SetNull)

  @@index([kind, published])
  @@map("pages")
}

model Menu {
  id        String   @id @default(uuid(7)) @db.Uuid
  slug      String   @unique @db.VarChar(48)
  name      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items MenuItem[]

  @@map("menus")
}

model MenuItem {
  id       String  @id @default(uuid(7)) @db.Uuid
  menuId   String  @db.Uuid
  parentId String? @db.Uuid
  label    Json
  url      String  @db.VarChar(400)
  /// Renders a mega-menu column with an image when set (F-ST-02).
  imageKey String? @db.VarChar(400)
  position Int     @default(0)
  openInNewTab Boolean @default(false)

  menu     Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent   MenuItem?  @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children MenuItem[] @relation("MenuTree")

  @@index([menuId, position])
  @@map("menu_items")
}

model Banner {
  id        String    @id @default(uuid(7)) @db.Uuid
  name      String    @db.VarChar(120)
  /// "home_hero" | "collection_top" | "cart_upsell"…
  placement String    @db.VarChar(48)
  title     Json?
  subtitle  Json?
  ctaLabel  Json?
  ctaUrl    String?   @db.VarChar(400)
  mediaId   String?   @db.Uuid
  position  Int       @default(0)
  active    Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  media Media? @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([placement, active, position])
  @@map("banners")
}

model Announcement {
  id        String    @id @default(uuid(7)) @db.Uuid
  message   Json
  linkUrl   String?   @db.VarChar(400)
  bgColor   String?   @db.VarChar(7)
  textColor String?   @db.VarChar(7)
  position  Int       @default(0)
  active    Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([active, startsAt, endsAt])
  @@map("announcements")
}

/// Home page builder — PRD F-AD-23, one row per draggable section.
model HomeSection {
  id           String    @id @default(uuid(7)) @db.Uuid
  /// "hero_3d" | "featured_collections" | "new_arrivals" | "best_sellers" |
  /// "promo_countdown" | "lookbook" | "brand_story" | "testimonials" | "newsletter"
  kind         String    @db.VarChar(48)
  title        Json?
  subtitle     Json?
  ctaLabel     Json?
  ctaUrl       String?   @db.VarChar(400)
  mediaId      String?   @db.Uuid
  collectionId String?   @db.Uuid
  productId    String?   @db.Uuid
  /// Section-specific knobs: item counts, model url, countdown target, colours.
  config       Json?
  position     Int       @default(0)
  active       Boolean   @default(true)
  startsAt     DateTime?
  endsAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  media      Media?      @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  product    Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([active, position])
  @@map("home_sections")
}

model Redirect {
  id        String   @id @default(uuid(7)) @db.Uuid
  fromPath  String   @unique @db.VarChar(400)
  toPath    String   @db.VarChar(400)
  statusCode Int     @default(301)
  hits      Int      @default(0)
  createdAt DateTime @default(now())

  @@map("redirects")
}

model NewsletterSubscriber {
  id           String    @id @default(uuid(7)) @db.Uuid
  email        String?   @unique @db.VarChar(255)
  phone        String?   @unique @db.VarChar(20)
  locale       String    @default("fr") @db.VarChar(5)
  source       String?   @db.VarChar(48)
  confirmedAt  DateTime?
  unsubscribedAt DateTime?
  createdAt    DateTime  @default(now())

  @@map("newsletter_subscribers")
}

model ContactMessage {
  id        String    @id @default(uuid(7)) @db.Uuid
  name      String    @db.VarChar(120)
  email     String?   @db.VarChar(255)
  phone     String?   @db.VarChar(20)
  subject   String?   @db.VarChar(200)
  body      String    @db.Text
  readAt    DateTime?
  repliedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([readAt, createdAt])
  @@map("contact_messages")
}

// ---------------------------------------------------------------------------
// Marketing — PRD Sections 5.3 and 6.5
// ---------------------------------------------------------------------------

model Affiliate {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @db.VarChar(160)
  handle      String   @unique @db.VarChar(64)
  phone       String?  @db.VarChar(20)
  email       String?  @db.VarChar(255)
  promotionId String?  @db.Uuid
  /// Commission on attributed revenue, paid manually in v1.
  commissionPercent Decimal @default(0) @db.Decimal(5, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  promotion Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  @@map("affiliates")
}

model LoyaltyTransaction {
  id         String   @id @default(uuid(7)) @db.Uuid
  customerId String   @db.Uuid
  orderId    String?  @db.Uuid
  /// Positive to earn, negative to redeem or adjust down.
  points     Int
  /// "earn" | "redeem" | "adjust" | "expire"
  kind       String   @db.VarChar(16)
  note       String?  @db.VarChar(300)
  balanceAfter Int
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order    Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@map("loyalty_transactions")
}

/// PRD F-ST-46 / F-AD-25: a cart with a phone number that never became an order.
model AbandonedCart {
  id          String    @id @default(uuid(7)) @db.Uuid
  cartId      String    @unique @db.Uuid
  customerId  String?   @db.Uuid
  phone       String?   @db.VarChar(20)
  fullName    String?   @db.VarChar(120)
  wilayaCode  Int?
  itemCount   Int       @default(0)
  subtotal    BigInt    @default(0)
  currency    String    @default("DZD") @db.Char(3)
  /// One-time code generated for the recovery message.
  recoveryCode String?  @db.VarChar(48)
  contactedAt DateTime?
  recoveredOrderId String? @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  cart     Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([contactedAt, createdAt])
  @@map("abandoned_carts")
}

// ---------------------------------------------------------------------------
// System — PRD Sections 5.10 and 10.3
// ---------------------------------------------------------------------------

model Setting {
  /// Dotted key, e.g. "orders.stock_deduction_moment" (see DECISIONS D20).
  key       String   @id @db.VarChar(120)
  scope     String   @default("global") @db.VarChar(48)
  value     Json
  /// Marks values that must never leave the server unredacted.
  secret    Boolean  @default(false)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([scope])
  @@map("settings")
}

model NotificationTemplate {
  id        String              @id @default(uuid(7)) @db.Uuid
  /// Event key: "order.placed", "order.shipped", "cart.abandoned"…
  event     String              @db.VarChar(64)
  channel   NotificationChannel
  subject   Json?
  body      Json
  active    Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([event, channel])
  @@map("notification_templates")
}

model Notification {
  id        String              @id @default(uuid(7)) @db.Uuid
  userId    String?             @db.Uuid
  channel   NotificationChannel @default(IN_APP)
  event     String              @db.VarChar(64)
  title     String              @db.VarChar(200)
  body      String?             @db.Text
  /// Deep link into the admin, e.g. "/orders/{id}".
  link      String?             @db.VarChar(400)
  recipient String?             @db.VarChar(255)
  /// "queued" | "sent" | "failed" | "read"
  status    String              @default("queued") @db.VarChar(16)
  error     String?             @db.VarChar(500)
  readAt    DateTime?
  sentAt    DateTime?
  metadata  Json?
  createdAt DateTime            @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([status, createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @db.Uuid
  actorLabel String?  @db.VarChar(160)
  action     String   @db.VarChar(64)
  entityType String   @db.VarChar(64)
  entityId   String?  @db.VarChar(64)
  /// Field-level before/after diff, secrets redacted by the interceptor.
  changes    Json?
  ip         String?  @db.VarChar(64)
  userAgent  String?  @db.VarChar(400)
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

/// Server-side storefront events — PRD F-AD-82, no PII beyond a customer id.
model AnalyticsEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  /// "page_view" | "product_view" | "add_to_cart" | "checkout_start" | "purchase"
  name       String   @db.VarChar(48)
  sessionId  String   @db.VarChar(64)
  customerId String?  @db.Uuid
  productId  String?  @db.Uuid
  variantId  String?  @db.Uuid
  orderId    String?  @db.Uuid
  path       String?  @db.VarChar(400)
  referrer   String?  @db.VarChar(400)
  utmSource  String?  @db.VarChar(120)
  utmMedium  String?  @db.VarChar(120)
  utmCampaign String? @db.VarChar(120)
  /// Search terms land here so the zero-result report is a group-by.
  query      String?  @db.VarChar(200)
  resultCount Int?
  value      BigInt?
  device     String?  @db.VarChar(24)
  wilayaCode Int?
  metadata   Json?
  occurredAt DateTime @default(now())

  @@index([name, occurredAt])
  @@index([sessionId, occurredAt])
  @@index([productId, name])
  @@map("analytics_events")
}

/// Raw inbound webhook bodies, kept for replay and for proving what a courier sent.
model WebhookInbound {
  id          String    @id @default(uuid(7)) @db.Uuid
  provider    String    @db.VarChar(48)
  /// "courier" | "payment"
  kind        String    @db.VarChar(24)
  signature   String?   @db.VarChar(400)
  headers     Json?
  payload     Json
  processedAt DateTime?
  error       String?   @db.VarChar(500)
  /// Deduplicates redelivered webhooks (PRD Section 10.3).
  idempotencyKey String? @unique @db.VarChar(128)
  createdAt   DateTime  @default(now())

  @@index([provider, processedAt])
  @@map("webhooks_inbound")
}

/// Fallback job table for environments without Redis; BullMQ is the default (D10).
model Job {
  id          String    @id @default(uuid(7)) @db.Uuid
  queue       String    @db.VarChar(48)
  name        String    @db.VarChar(64)
  payload     Json
  status      String    @default("pending") @db.VarChar(16)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  runAt       DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  error       String?   @db.Text
  createdAt   DateTime  @default(now())

  @@index([queue, status, runAt])
  @@map("jobs")
}
